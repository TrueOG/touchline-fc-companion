{
  "name": "fc-manual-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": { "express": "^5.1.0", "playwright": "^1.56.0", "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@playwright/test": "^1.56.0", "@types/express": "^5.0.3", "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0", "vitest": "^4.0.0" }
}
